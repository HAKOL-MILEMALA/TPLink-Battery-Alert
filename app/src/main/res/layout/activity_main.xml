<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TP-Link Battery Alert"
            android:textColor="#18324A"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ניטור סוללת הנתב הנייד והתראה כשהסוללה מגיעה ל-10% ומטה."
            android:textColor="#526579"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/howToButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="איך מתחילים?"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="גרסה מותקנת"
            android:textColor="#708090"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="אחוז הסוללה"
                android:textColor="#526579"
                android:textSize="15sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/batteryPercentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#18324A"
                android:textSize="54sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/batteryUpdatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="עדיין לא התקבלה קריאת סוללה."
                android:textColor="#708090"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מצב החיבור"
            android:textColor="#263746"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="7dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="הניטור כבוי"
            android:textColor="#526579"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סיסמת הניהול של הנתב"
            android:textColor="#263746"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="7dp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#1769AA"
            android:hint="הזן את סיסמת הניהול"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textDirection="ltr"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="זו סיסמת הניהול של ממשק הנתב, ולא בהכרח סיסמת ה-Wi-Fi. הסיסמה נשמרת מוצפנת ומשמשת לחיבור מקומי בלבד."
            android:textColor="#708090"
            android:textSize="12sp"
            android:paddingTop="7dp"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="שמור והפעל ניטור"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="הפסק ניטור"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/backgroundSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="הגדר הפעלה אוטומטית ברקע"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D9E1E8"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדכוני אפליקציה"
            android:textColor="#263746"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="7dp" />

        <TextView
            android:id="@+id/updateStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="אפשר לבדוק עדכונים בכל רגע."
            android:textColor="#34495E"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/checkUpdatesButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="בדוק עדכונים עכשיו"
            android:layout_marginTop="9dp" />

        <Button
            android:id="@+id/downloadUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="הורד והתקן עדכון"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/githubButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="קוד המקור והגרסאות ב-GitHub"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סף התראה: 10% ומטה • תזכורת כל 3 דקות • איפוס בטעינה או מעל 15%"
            android:textColor="#8292A1"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</ScrollView>
