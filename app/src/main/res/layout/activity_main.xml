<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ניטור סוללת TP-Link M7200"
            android:textColor="#18324A"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="האפליקציה תבדוק את הסוללה דרך ה-Wi-Fi של המולטימדיה ותתריע פעם אחת כשהיא מגיעה ל-10%."
            android:textColor="#526579"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="גרסה מותקנת: 1.0.2"
            android:textColor="#708090"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סיסמת הניהול של הנתב"
            android:textColor="#263746"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="7dp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#1769AA"
            android:hint="הזן את סיסמת הניהול של M7200"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textDirection="ltr"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הסיסמה נשמרת מוצפנת במולטימדיה ומשמשת רק להתחברות מקומית לנתב."
            android:textColor="#708090"
            android:textSize="12sp"
            android:paddingTop="7dp"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="שמור והפעל ניטור"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="הפסק ניטור"
            android:layout_marginTop="9dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D9E1E8"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מצב נוכחי"
            android:textColor="#263746"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="7dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="הניטור עדיין לא הופעל."
            android:textColor="#34495E"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D9E1E8"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדכוני אפליקציה"
            android:textColor="#263746"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="7dp" />

        <TextView
            android:id="@+id/updateStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="בדיקת עדכונים אוטומטית מתבצעת מדי פעם, ואפשר לבדוק גם בלחיצה."
            android:textColor="#34495E"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/checkUpdatesButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="בדוק עדכונים עכשיו"
            android:layout_marginTop="9dp" />

        <Button
            android:id="@+id/downloadUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="הורד והתקן עדכון"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/githubButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="קוד המקור והגרסאות ב-GitHub"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כתובת הנתב: 192.168.0.1  •  סף התראה: 10%"
            android:textColor="#8292A1"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</ScrollView>
